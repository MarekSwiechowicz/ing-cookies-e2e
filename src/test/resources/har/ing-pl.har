hu, 15 Oct 2026 16:33:01 GMT"},{"name":"Etag","value":"\"d4aafa41\""},{"name":"Expires","value":"Thu, 15 Oct 2026 16:45:14 GMT"},{"name":"X-CDN","value":"Imperva"},{"name":"X-Iinfo","value":"54-113632762-0 0CNN RT(1792081981657 523) q(0 -1 -1 -1) r(0 -1)"},{"name":"access-control-allow-origin","value":"*"}],"content":{"size":47580,"mimeType":"application/x-javascript","compression":39421,"text":"window.CookiePolicyManager&&window.removeEventListener('content-replace',CookiePolicyManager.__handler),function(e,t){'function'==typeof define&&define.amd?define(_,t):'object'==typeof module&&module.exports?module.exports=t():e.CookiePolicyManager=t()}(this,(function(){const e=JSON.parse('{\"cookieName\":\"cookiePolicyGDPR\",\"cookieExpirationTimeInDays\":365,\"postponedStatus\":0,\"allAcceptedStatus\":4,\"analyticalAcceptedStatus\":3,\"marketingAcceptedStatus\":2,\"technicalAcceptedStatus\":1,\"htmlContent\":\"\\u0026lt;div class\\u003d\\u0026quot;js-cookie-policy-box cpm-wrapper--hook\\u0026quot; id\\u003d\\u0026quot;cpm-wrapper\\u0026quot; data-banner-type\\u003d\\u0026quot;all\\u0026quot; style\\u003d\\u0026quot;visibility: hidden; pointer-events: none; opacity: 0\\u0026quot;\\u0026gt;\\u0026lt;link crossorigin\\u003d\\u0026quot;anonymous\\u0026quot; data-type\\u003d\\u0026quot;cookies-policy\\u0026quot; rel\\u003d\\u0026quot;stylesheet\\u0026quot; type\\u003d\\u0026quot;text/css\\u0026quot; href\\u003d\\u0026quot;https://www.ing.pl/_api/ds/ingrwd-lds/cookie_policy/150018/cpm.css\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cpm__transitionHelper\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-non_aggressive-popup js-cookie-policy-non_aggressive-popup\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;js-cookie-policy-main cookie-policy-popup cpm--hidden cookie-policy-popup--all\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-content\\u0026quot; role\\u003d\\u0026quot;dialog\\u0026quot; tabindex\\u003d\\u0026quot;0\\u0026quot;\\u0026gt;\\u0026lt;div aria-labelledby\\u003d\\u0026quot;modal-header-1\\u0026quot; class\\u003d\\u0026quot;cookie-policy-inner\\u0026quot;\\u0026gt;\\u0026lt;h2 class\\u003d\\u0026quot;cookie-policy-title state-scroll\\u0026quot; id\\u003d\\u0026quot;modal-header-1\\u0026quot;\\u0026gt;ING Bank \\u0026#346;l\\u0026#261;ski (my) korzysta z \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; i innych podobnych technologii\\u0026lt;/h2\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-description\\u0026quot;\\u0026gt;\\u0026lt;p\\u0026gt;Je\\u0026#347;li zaakceptujesz wszystkie \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;, zapiszemy w Twoim urz\\u0026#261;dzeniu \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; i inne pliki (og\\u0026oacute;lnie \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;) analityczne i marketingowe (obejmuj\\u0026#261;ce profilowanie marketingowe, w tym personalizacj\\u0026#281; reklam), w tym \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; zaufanych partner\\u0026oacute;w. Je\\u0026#347;li odrzucisz wszystkie - zapiszemy tylko \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; techniczne, niezb\\u0026#281;dne dla dzia\\u0026#322;ania naszych stron. \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;Cookies\\u0026lt;/span\\u0026gt; mo\\u0026#380;esz te\\u0026#380; ustawi\\u0026#263; samodzielnie (Dostosuj). U\\u0026#380;ywamy \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; zgodnie z \\u0026lt;a  href\\u003d\\u0026quot;https://www.ing.pl/indywidualni/tabele-i-regulaminy/regulacje/ochrona-danych-osobowych\\u0026quot;\\u0026gt;Polityk\\u0026#261; prywatno\\u0026#347;ci\\u0026lt;/a\\u0026gt; i \\u0026lt;a href\\u003d\\u0026quot;https://www.ing.pl/cookie\\u0026quot;\\u0026gt;Polityk\\u0026#261; \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;\\u0026lt;/a\\u0026gt; (zwanymi Politykami), kt\\u0026oacute;re opisuj\\u0026#261; rodzaje \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;, sposoby korzystania z nich przez nas, usuwania \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; naszych oraz naszych zaufanych partner\\u0026oacute;w. Zapiszemy Tw\\u0026oacute;j wyb\\u0026oacute;r. Zgodnie z Politykami mo\\u0026#380;esz zmienia\\u0026#263; ustawienia lub wycofa\\u0026#263; zgody. Je\\u0026#347;li wyrazisz zgod\\u0026#281; na \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; analityczne lub marketingowe, istnieje mo\\u0026#380;liwo\\u0026#347;\\u0026#263;, \\u0026#380;e Twoje dane zostan\\u0026#261; przekazane do kraju spoza Unii Europejskiej, kt\\u0026oacute;ry mo\\u0026#380;e nie zapewnia\\u0026#263; odpowiedniego poziomu ochrony danych.\\u0026lt;/p\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-btn-group state-scroll\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-btn-wrapper\\u0026quot;\\u0026gt;\\u0026lt;button class\\u003d\\u0026quot;js-cookie-policy-main-settings-button cookie-policy-button is--primary\\u0026quot;\\u0026gt;Dostosuj\\u0026lt;/button\\u0026gt;\\u0026lt;button class\\u003d\\u0026quot;js-cookie-policy-main-decline-button cookie-policy-button is--primary\\u0026quot;\\u0026gt;Odrzu\\u0026#263; wszystkie\\u0026lt;/button\\u0026gt;\\u0026lt;button class\\u003d\\u0026quot;js-cookie-policy-main-accept-button cookie-policy-button is--primary\\u0026quot;\\u0026gt;Zaakceptuj wszystkie\\u0026lt;/button\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;js-cookie-policy-settings cpm--hidden cookie-policy-popup cookie-policy-popup--settings\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-content\\u0026quot; role\\u003d\\u0026quot;dialog\\u0026quot; tabindex\\u003d\\u0026quot;0\\u0026quot;\\u0026gt;\\u0026lt;div aria-labelledby\\u003d\\u0026quot;modal-header-2\\u0026quot; class\\u003d\\u0026quot;cookie-policy-inner\\u0026quot;\\u0026gt;\\u0026lt;button class\\u003d\\u0026quot;cookie-policy-arrow--left js-cookie-policy-settings-cancel-button\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy__srOnly\\u0026quot;\\u0026gt;Wyjd\\u0026#378; z ustawie\\u0026#324;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;h2 class\\u003d\\u0026quot;cookie-policy-title state-scroll\\u0026quot; id\\u003d\\u0026quot;modal-header-2\\u0026quot;\\u0026gt;Ustawienia plik\\u0026oacute;w \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; i innych technologii\\u0026lt;/h2\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;js-cookie-policy-settings-acceptance-form cookie-policy-description\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type-wrapper\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type--content\\u0026quot;\\u0026gt;\\u0026lt;h3 class\\u003d\\u0026quot;cookie-policy-type--title js-cookie-policy-title\\u0026quot; id\\u003d\\u0026quot;header-1-technical\\u0026quot;\\u0026gt;\\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;Cookies\\u0026lt;/span\\u0026gt; techniczne\\u0026lt;/h3\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type--description\\u0026quot; id\\u003d\\u0026quot;desc-wrapper-1-technical\\u0026quot;\\u0026gt;\\u0026lt;p id\\u003d\\u0026quot;desc-1-technical\\u0026quot;\\u0026gt;Niezb\\u0026#281;dne dla prawid\\u0026#322;owego dzia\\u0026#322;ania naszych stron, s\\u0026#261; wi\\u0026#281;c zawsze aktywne.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-technical\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot; data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot;   data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach technicznych\\u0026quot;   data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach technicznych\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot;   class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;   \\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;       Rozwi\\u0026#324;   \\u0026lt;/span\\u0026gt;   \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-technical\\u0026quot;\\u0026gt;   \\u0026lt;p\\u0026gt;Wykorzystujemy je m.in. do zapami\\u0026#281;tywania wyra\\u0026#380;onych przez Ciebie zg\\u0026oacute;d. Mo\\u0026#380;esz zablokowa\\u0026#263; techniczne \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; w       ustawieniach swojej przegl\\u0026#261;darki, ale w\\u0026oacute;wczas strona mo\\u0026#380;e przesta\\u0026#263; dzia\\u0026#322;a\\u0026#263; lub nie dzia\\u0026#322;a\\u0026#263; poprawnie. Za ich       pomoc\\u0026#261; nie zbieramy danych osobowych.\\u0026lt;/p\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-switch\\u0026quot;\\u0026gt;\\u0026lt;div aria-checked\\u003d\\u0026quot;true\\u0026quot; aria-describedby\\u003d\\u0026quot;desc-1-technical\\u0026quot; aria-disabled\\u003d\\u0026quot;true\\u0026quot; aria-labelledby\\u003d\\u0026quot;header-1-technical\\u0026quot; class\\u003d\\u0026quot;cookie-policy-toggle-button state-disabled js-checkbox\\u0026quot; name\\u003d\\u0026quot;CpmTechnicalOption\\u0026quot; role\\u003d\\u0026quot;switch\\u0026quot; tabindex\\u003d\\u0026quot;-1\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy-toggle-slider\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy-slider-thumb\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type--content\\u0026quot;\\u0026gt;\\u0026lt;h3 class\\u003d\\u0026quot;cookie-policy-type--title clickable js-cookie-policy-title\\u0026quot; id\\u003d\\u0026quot;header-2-analytical\\u0026quot;\\u0026gt;\\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;Cookies\\u0026lt;/span\\u0026gt; analityczne\\u0026lt;/h3\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type--description\\u0026quot; id\\u003d\\u0026quot;desc-wrapper-2-analytical\\u0026quot;\\u0026gt;\\u0026lt;p id\\u003d\\u0026quot;desc-2-analytical\\u0026quot;\\u0026gt;Umo\\u0026#380;liwiaj\\u0026#261; nam gromadzenie danych na temat stron, kt\\u0026oacute;re wy\\u0026#347;wietlasz, dzia\\u0026#322;a\\u0026#324;, jakie na nich podejmujesz czy miejsc,   z kt\\u0026oacute;rych do nas trafiasz.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-analytical\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot;   data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot; data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach analitycznych\\u0026quot;   data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach analitycznych\\u0026quot; class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;   \\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;Rozwi\\u0026#324;\\u0026lt;/span\\u0026gt;   \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-analytical\\u0026quot;\\u0026gt;  \\u0026lt;p\\u0026gt;Dzi\\u0026#281;ki \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; analitycznym mo\\u0026#380;emy poprawia\\u0026#263; funkcjonowanie strony, mierzy\\u0026#263; skuteczno\\u0026#347;\\u0026#263; dzia\\u0026#322;a\\u0026#324; marketingowych i       rozlicza\\u0026#263; si\\u0026#281; z partnerami biznesowymi. Za ich pomoc\\u0026#261; nie zbieramy danych osobowych.\\u0026lt;/p\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-switch\\u0026quot;\\u0026gt;\\u0026lt;div aria-checked\\u003d\\u0026quot;false\\u0026quot; aria-describedby\\u003d\\u0026quot;desc-2-analytical\\u0026quot; aria-labelledby\\u003d\\u0026quot;header-2-analytical\\u0026quot; class\\u003d\\u0026quot;cookie-policy-toggle-button js-checkbox\\u0026quot; name\\u003d\\u0026quot;CpmAnalyticalOption\\u0026quot; role\\u003d\\u0026quot;switch\\u0026quot; tabindex\\u003d\\u0026quot;0\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy-toggle-slider\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy-slider-thumb\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type--content\\u0026quot;\\u0026gt;\\u0026lt;h3 class\\u003d\\u0026quot;cookie-policy-type--title clickable js-cookie-policy-title\\u0026quot; id\\u003d\\u0026quot;header-3-marketing\\u0026quot;\\u0026gt;\\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;Cookies\\u0026lt;/span\\u0026gt; marketingowe\\u0026lt;/h3\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-type--description\\u0026quot; id\\u003d\\u0026quot;desc-wrapper-3-marketing\\u0026quot;\\u0026gt;\\u0026lt;p id\\u003d\\u0026quot;desc-3-marketing\\u0026quot;\\u0026gt;Pozwalaj\\u0026#261; nam na przedstawianie profilowanych informacji handlowych dostosowanych do Twoich wybor\\u0026oacute;w lub stron, kt\\u0026oacute;re   odwiedzasz w Internecie.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-marketing\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot; data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot;   data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach marketingowych\\u0026quot;   data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach marketingowych\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot;   class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;Rozwi\\u0026#324;\\u0026lt;/span\\u0026gt;   \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-marketing\\u0026quot;\\u0026gt;   \\u0026lt;p\\u0026gt;Dzi\\u0026#281;ki nim wiemy, jak korzystasz z serwisu, w tym z oferowanych us\\u0026#322;ug, mo\\u0026#380;emy te\\u0026#380; \\u0026#322;\\u0026#261;czy\\u0026#263; zabrane na ich       podstawie       dane i informacje z innymi dotycz\\u0026#261;cymi Ciebie informacjami, kt\\u0026oacute;re mamy lub otrzymamy w przysz\\u0026#322;o\\u0026#347;ci. Zapoznaj       si\\u0026#281;       z \\u0026lt;a href\\u003d\\u0026quot;https://www.ing.pl/indywidualni/tabele-i-regulaminy/regulacje/ochrona-danych-osobowych\\u0026quot;\\u0026gt;wyja\\u0026#347;nieniami           u\\u0026#380;ytych tu termin\\u0026oacute;w i informacj\\u0026#261; banku\\u0026lt;/a\\u0026gt;.\\u0026lt;/p\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-switch\\u0026quot;\\u0026gt;\\u0026lt;div aria-checked\\u003d\\u0026quot;false\\u0026quot; aria-describedby\\u003d\\u0026quot;desc-3-marketing\\u0026quot; aria-labelledby\\u003d\\u0026quot;header-3-marketing\\u0026quot; class\\u003d\\u0026quot;cookie-policy-toggle-button js-checkbox\\u0026quot; name\\u003d\\u0026quot;CpmMarketingOption\\u0026quot; role\\u003d\\u0026quot;switch\\u0026quot; tabindex\\u003d\\u0026quot;0\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy-toggle-slider\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;cookie-policy-slider-thumb\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-btn-group state-scroll\\u0026quot;\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-btn-wrapper cookie-policy-btn-wrapper--settings cookie-policy-btn-wrapper--secondary\\u0026quot;\\u0026gt;\\u0026lt;button class\\u003d\\u0026quot;js-cookie-policy-settings-decline-all-button cookie-policy-button is--primary\\u0026quot;\\u0026gt;Odrzu\\u0026#263; wszystkie\\u0026lt;/button\\u0026gt;\\u0026lt;button class\\u003d\\u0026quot;js-cookie-policy-settings-decline-button cookie-policy-button is--primary\\u0026quot;\\u0026gt;Zaakceptuj zaznaczone\\u0026lt;/button\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\\u0026lt;/div\\u0026gt;\",\"isAdobeDirectCallEnabled\":false,\"isDataLayerPushEnabled\":true,\"afterResetDescription\":\"\\u0026lt;p\\u0026gt;Wprowadzili\\u0026#347;my zmiany w niekt\\u0026oacute;rych plikach cookie. Je\\u0026#347;li zaakceptujesz wszystkie \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;, zapiszemy w Twoim urz\\u0026#261;dzeniu \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; i inne pliki (og\\u0026oacute;lnie \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;) analityczne i marketingowe (obejmuj\\u0026#261;ce profilowanie marketingowe, w tym personalizacj\\u0026#281; reklam), w tym \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; zaufanych partner\\u0026oacute;w. Je\\u0026#347;li odrzucisz wszystkie - zapiszemy tylko \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; techniczne, niezb\\u0026#281;dne dla dzia\\u0026#322;ania naszych stron. \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;Cookies\\u0026lt;/span\\u0026gt; mo\\u0026#380;esz te\\u0026#380; ustawi\\u0026#263; samodzielnie (Dostosuj). U\\u0026#380;ywamy \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; zgodnie z \\u0026lt;a href\\u003d\\u0026quot;https://www.ing.pl/indywidualni/tabele-i-regulaminy/regulacje/ochrona-danych-osobowych\\u0026quot;\\u0026gt;Polityk\\u0026#261; prywatno\\u0026#347;ci\\u0026lt;/a\\u0026gt; i \\u0026lt;a  href\\u003d\\u0026quot;https://www.ing.pl/cookie\\u0026quot;\\u0026gt;Polityk\\u0026#261; \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;\\u0026lt;/a\\u0026gt; (zwanymi Politykami), kt\\u0026oacute;re opisuj\\u0026#261; rodzaje \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt;, sposoby korzystania z nich przez nas, usuwania \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; naszych oraz naszych zaufanych partner\\u0026oacute;w. Zapiszemy Tw\\u0026oacute;j wyb\\u0026oacute;r. Zgodnie z Politykami mo\\u0026#380;esz zmienia\\u0026#263; ustawienia lub wycofa\\u0026#263; zgody. Je\\u0026#347;li wyrazisz zgod\\u0026#281; na \\u0026lt;span lang\\u003d\\u0026quot;en\\u0026quot;\\u0026gt;cookies\\u0026lt;/span\\u0026gt; analityczne lub marketingowe, istnieje mo\\u0026#380;liwo\\u0026#347;\\u0026#263;, \\u0026#380;e Twoje dane zostan\\u0026#261; przekazane do kraju spoza Unii Europejskiej, kt\\u0026oacute;ry mo\\u0026#380;e nie zapewnia\\u0026#263; odpowiedniego poziomu ochrony danych.\\u0026lt;/p\\u0026gt;\",\"settingsTechnicalCookiesDescriptionChanged\":\"\\u0026lt;p id\\u003d\\u0026quot;desc-1-technical\\u0026quot;\\u0026gt;Wprowadzili\\u0026#347;my zmiany w cookies technicznych przetwarzaj\\u0026#261;cych dane osobowe. Zapoznaj si\\u0026#281; ze szczeg\\u0026oacute;\\u0026#322;ami zmian na \\u0026lt;a        href\\u003d\\u0026quot;https://www.ing.pl/indywidualni/tabele-i-regulaminy/regulacje/polityka-plikow-cookie\\u0026quot;\\u0026gt;stronie Polityki    Cookies.\\u0026lt;/a\\u0026gt;\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-technical\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot; data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot;        data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach technicznych\\u0026quot;        data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach technicznych\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot;        class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;   \\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;       Rozwi\\u0026#324;   \\u0026lt;/span\\u0026gt;    \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-technical\\u0026quot;\\u0026gt;    \\u0026lt;p\\u0026gt;Wykorzystujemy je m.in. do zapami\\u0026#281;tywania wyra\\u0026#380;onych przez Ciebie zg\\u0026oacute;d. Mo\\u0026#380;esz zablokowa\\u0026#263; techniczne cookies w        ustawieniach swojej przegl\\u0026#261;darki, ale w\\u0026oacute;wczas strona mo\\u0026#380;e nie dzia\\u0026#322;a\\u0026#263; poprawnie.\\u0026lt;/p\\u0026gt;\\u0026lt;/div\\u0026gt;\",\"settingsTechnicalCookiesDescriptionNotChanged\":\"\\u0026lt;p id\\u003d\\u0026quot;desc-1-technical\\u0026quot;\\u0026gt;Nie wprowadzili\\u0026#347;my zmiany w cookies technicznych przetwarzaj\\u0026#261;cych dane osobowe.  Cookies techniczne s\\u0026#261; niezb\\u0026#281;dne dla prawid\\u0026#322;owego dzia\\u0026#322;anianaszych stron, s\\u0026#261; wi\\u0026#281;c zawsze zapisywane na Twoim urz\\u0026#261;dzeniu.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-technical\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot; data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot;        data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach technicznych\\u0026quot;        data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach technicznych\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot;        class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;   \\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;       Rozwi\\u0026#324;   \\u0026lt;/span\\u0026gt;    \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-technical\\u0026quot;\\u0026gt;\\u0026lt;p\\u0026gt;Wykorzystujemy je m.in. do zapami\\u0026#281;tywania wyra\\u0026#380;onych przez Ciebie zg\\u0026oacute;d. Mo\\u0026#380;esz zablokowa\\u0026#263; techniczne cookies w ustawieniach swojej    przegl\\u0026#261;darki, ale w\\u0026oacute;wczas strona mo\\u0026#380;e nie dzia\\u0026#322;a\\u0026#263; poprawnie.\\u0026lt;/p\\u0026gt; \\u0026lt;/div\\u0026gt;\",\"settingsAnalyticalCookiesDescriptionChanged\":\"\\u0026lt;p id\\u003d\\u0026quot;desc-2-analytical\\u0026quot;\\u0026gt;Wprowadzilismy zmiany w cookies analitycznych, dlatego ponownie prosimy Ci\\u0026#281; o  wyra\\u0026#380;enie zgody na dzia\\u0026#322;ania korzystaj\\u0026#261;ce z nich. Zapoznaj si\\u0026#281; ze szczeg\\u0026oacute;\\u0026#322;ami zmian na \\u0026lt;a href\\u003d\\u0026quot;https://www.ing.pl/indywidualni/tabele-i-regulaminy/regulacje/polityka-plikow-cookie\\u0026quot;\\u0026gt;stronie Polityki Cookies.\\u0026lt;/a\\u0026gt;  Zarz\\u0026#261;dzanie zgodami dost\\u0026#281;pne jest przez link \\u0026quot;Ustawienia cookie\\u0026quot; na dole strony.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-analytical\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot;data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot; data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach analitycznych\\u0026quot;data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach analitycznych\\u0026quot; class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;Rozwi\\u0026#324;\\u0026lt;/span\\u0026gt;\\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-analytical\\u0026quot;\\u0026gt;\\u0026lt;p\\u0026gt;Dzi\\u0026#281;ki cookies analitycznym mo\\u0026#380;emy poprawia\\u0026#263; funkcjonowanie strony, mierzy\\u0026#263; skuteczno\\u0026#347;\\u0026#263; dzia\\u0026#322;a\\u0026#324; marketingowych i rozlicza\\u0026#263; si\\u0026#281; z partnerami biznesowymi.\\u0026lt;/p\\u0026gt; \\u0026lt;/div\\u0026gt;\",\"settingsAnalyticalCookiesDescriptionNotChanged\":\"\\u0026lt;p id\\u003d\\u0026quot;desc-2-analytical\\u0026quot;\\u0026gt;Nie wprowadzili\\u0026#347;my zmian w cookies analitycznych. W dalszym ci\\u0026#261;gu uznajemy Twoj\\u0026#261; poprzedni\\u0026#261; zgod\\u0026#281; lub jej brak za aktualn\\u0026#261;. Mo\\u0026#380;esz w ka\\u0026#380;dym momencie to zmieni\\u0026#263; prze\\u0026#322;\\u0026#261;cznikiem. Zarz\\u0026#261;dzanie zgodami dost\\u0026#281;pne jest przez link \\u0026quot;Ustawienia cookie\\u0026quot; na dole strony.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-analytical\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot;data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot; data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach analitycznych\\u0026quot;data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach analitycznych\\u0026quot; class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;Rozwi\\u0026#324;\\u0026lt;/span\\u0026gt;\\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-analytical\\u0026quot;\\u0026gt;\\u0026lt;p\\u0026gt;Dzi\\u0026#281;ki cookies analitycznym mo\\u0026#380;emy poprawia\\u0026#263; funkcjonowanie strony, mierzy\\u0026#263; skuteczno\\u0026#347;\\u0026#263; dzia\\u0026#322;a\\u0026#324; marketingowych i rozlicza\\u0026#263; si\\u0026#281; z partnerami biznesowymi.\\u0026lt;/p\\u0026gt; \\u0026lt;/div\\u0026gt;\",\"settingsMarketingCookiesDescriptionChanged\":\"\\u0026lt;p id\\u003d\\u0026quot;desc-3-marketing\\u0026quot;\\u0026gt;Wprowadzilismy zmiany w cookies marketingowych, dlatego ponownie prosimy Ci\\u0026#281; o wyra\\u0026#380;enie zgody na dzia\\u0026#322;ania    korzystaj\\u0026#261;ce z nich. Zapoznaj si\\u0026#281; ze szczeg\\u0026oacute;\\u0026#322;ami zmian na \\u0026lt;a href\\u003d\\u0026quot;https://www.ing.pl/indywidualni/tabele-i-regulaminy/regulacje/polityka-plikow-cookie\\u0026quot;\\u0026gt;stronie Polityki Cookies.\\u0026lt;/a\\u0026gt;. Zarz\\u0026#261;dzanie zgodami dost\\u0026#281;pne    jest przez link \\u0026quot;Ustawienia cookie\\u0026quot; na dole strony.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-marketing\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot; data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot;        data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach marketingowych\\u0026quot;        data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach marketingowych\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot;        class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;Rozwi\\u0026#324;\\u0026lt;/span\\u0026gt;    \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-marketing\\u0026quot;\\u0026gt;\\u0026lt;p\\u0026gt;Dzi\\u0026#281;ki nim wiemy, jak korzystasz z serwisu, w tym z oferowanych us\\u0026#322;ug, mo\\u0026#380;emy te\\u0026#380; \\u0026#322;\\u0026#261;czy\\u0026#263; zabrane na ich podstawie    dane i informacje z innymi dotycz\\u0026#261;cymi Ciebie informacjami, kt\\u0026oacute;re mamy lub otrzymamy w przysz\\u0026#322;o\\u0026#347;ci. Zapoznaj si\\u0026#281; z    wyja\\u0026#347;nieniami u\\u0026#380;ytych tu termin\\u0026oacute;w i informacj\\u0026#261; banku.\\u0026lt;/p\\u0026gt; \\u0026lt;/div\\u0026gt;\",\"settingsMarketingCookiesDescriptionNotChanged\":\"\\u0026lt;p id\\u003d\\u0026quot;desc-3-marketing\\u0026quot;\\u0026gt;Nie wprowadzili\\u0026#347;my zmian w cookies marketingowych. W dalszym ci\\u0026#261;gu uznajemy Twoj\\u0026#261; poprzedni\\u0026#261; zgod\\u0026#281; lub jej brak za    aktualn\\u0026#261;. Mo\\u0026#380;esz w ka\\u0026#380;dym momencie to zmieni\\u0026#263; prze\\u0026#322;\\u0026#261;cznikiem. Zarz\\u0026#261;dzanie zgodami dost\\u0026#281;pne jest przez link    \\u0026quot;Ustawienia cookie\\u0026quot; na dole strony.\\u0026lt;/p\\u0026gt;\\u0026lt;button aria-controls\\u003d\\u0026quot;cookie-policy-marketing\\u0026quot; data-expand\\u003d\\u0026quot;Rozwi\\u0026#324;\\u0026quot; data-collapse\\u003d\\u0026quot;Zwi\\u0026#324;\\u0026quot;        data-aria-expand\\u003d\\u0026quot;Rozwi\\u0026#324; informacj\\u0026#281; o ciasteczkach marketingowych\\u0026quot;        data-aria-collapse\\u003d\\u0026quot;Zwi\\u0026#324; informacj\\u0026#281; o ciasteczkach marketingowych\\u0026quot; aria-expanded\\u003d\\u0026quot;false\\u0026quot; aria-label\\u003d\\u0026quot;\\u0026quot;        class\\u003d\\u0026quot;cookie-policy-expandButton\\u0026quot;\\u0026gt;\\u0026lt;span class\\u003d\\u0026quot;expand_content__text\\u0026quot;\\u0026gt;Rozwi\\u0026#324;\\u0026lt;/span\\u0026gt;    \\u0026lt;span aria-hidden\\u003d\\u0026quot;true\\u0026quot; class\\u003d\\u0026quot;icon-arrow web-icon\\u0026quot;\\u0026gt;\\u0026lt;/span\\u0026gt;\\u0026lt;/button\\u0026gt;\\u0026lt;div class\\u003d\\u0026quot;cookie-policy-link--content\\u0026quot; id\\u003d\\u0026quot;cookie-policy-marketing\\u0026quot;\\u0026gt;\\u0026lt;p\\u0026gt;Dzi\\u0026#281;ki nim wiemy, jak korzystasz z serwisu, w tym z oferowanych us\\u0026#322;ug, mo\\u0026#380;emy te\\u0026#380; \\u0026#322;\\u0026#261;czy\\u0026#263; zabrane na ich podstawie    dane i informacje z innymi dotycz\\u0026#261;cymi Ciebie informacjami, kt\\u0026oacute;re mamy lub otrzymamy w przysz\\u0026#322;o\\u0026#347;ci. Zapoznaj si\\u0026#281; z    wyja\\u0026#347;nieniami u\\u0026#380;ytych tu termin\\u0026oacute;w i informacj\\u0026#261; banku.\\u0026lt;/p\\u0026gt; \\u0026lt;/div\\u0026gt;\",\"technicalConsentResetTimestamp\":1727770065793,\"analyticalConsentResetTimestamp\":1787553586502,\"marketingConsentResetTimestamp\":1774593981277}'),t=e=>(new DOMParser).parseFromString(e,'text/html').documentElement.textContent,n=t(e.htmlContent),i=document.createElement('div');i.innerHTML=n;const o=e.cookieName,c=e.cookieExpirationTimeInDays,a=e.postponedStatus,l=e.allAcceptedStatus,s=e.analyticalAcceptedStatus,r=e.marketingAcceptedStatus,C=e.tech