5313455\" class=\"layout_element component_wrapper wrapped_generic_block\">\n     <div class=\"component generic_block notPrintable component_1405313455 space--topZero space--bottomZero\" data-component-id=\"1405313455\" data-component-type-code=\"generic_block\" data-js-parameters=\"{}\">\n      <div class=\"generic_block__wrapper generic_block__with_link\">\n       <div class=\"generic_block__image\">\n        <img alt=\"\" class=\"generic_block__large-icon\" src=\"/_fileserver/item/1vlhgca.3c18ec00e748923306cc07655c4186a596ecdfb05dcb8273e05e8fe404613954\">\n       </div>\n       <div class=\"generic_block__text content_area\">\n        <h3 class=\"generic_block__header\">Ubezpieczenie dziecka</h3>\n        <div>\n         <div class=\"generic_block__link_after_text\">\n          <p>Chroni 24/7 na całym świecie. 3 warianty do wyboru.</p>\n          <a class=\"\" href=\"/indywidualni/ubezpieczenia/ubezpieczenie-dziecka\">Sprawdź</a>\n         </div>\n        </div>\n       </div>\n      </div>\n     </div>\n    </div>\n   </div>\n   <div class=\"layout_element layout_column col-xs-12 col-sm-12 col-md-6 col-lg-6\" style=\"padding:0px 15px 0px 15px\">\n    <div id=\"component_wrapper_1405313434\" class=\"layout_element component_wrapper wrapped_news_small_list\">\n     <div class=\"component news_small_list notPrintable header-upp component_1405313434\" data-component-id=\"1405313434\" data-component-type-code=\"news_small_list\" data-js-parameters=\"{}\" id=\"news_small_list_1_17062025\">\n      <div class=\"news_small_list-inner\">\n       <h2 class=\"news_small_list__header isMobileLink\">Aktualności</h2>\n       <ul class=\"news_small_list_content content_area\">\n        <li class=\"table_news\">\n         <div class=\"publication_cell\">\n          <time class=\"publication_date\" datetime=\"2026-10-15\" id=\"news_small_list_1405313434_1\"><span class=\"sr-only\">15 października 2026</span><span aria-hidden=\"true\" class=\"day\">15</span><span aria-hidden=\"true\" class=\"month\">października</span></time>\n         </div>\n         <div class=\"title_news\">\n          <a aria-describedby=\"news_small_list_1405313434_1\" class=\"news_small_list__link link_style_1\" href=\"/aktualnosci?news_id=1107476-nowa-oferta-oszczednosciowa-od-15-pazdziernika\">Nowa oferta oszczędnościowa od 15 października</a>\n         </div>\n        </li>\n        <li class=\"table_news\">\n         <div class=\"publication_cell\">\n          <time class=\"publication_date\" datetime=\"2026-10-12\" id=\"news_small_list_1405313434_2\"><span class=\"sr-only\">12 października 2026</span><span aria-hidden=\"true\" class=\"day\">12</span><span aria-hidden=\"true\" class=\"month\">października</span></time>\n         </div>\n         <div class=\"title_news\">\n          <a aria-describedby=\"news_small_list_1405313434_2\" class=\"news_small_list__link link_style_1\" href=\"/aktualnosci?news_id=1107446-konta-i-karty-z-velobanku-dostepne-w-moim-ing\">Konta i karty z VeloBanku dostępne w Moim ING</a>\n         </div>\n        </li>\n        <li class=\"table_news\">\n         <div class=\"publication_cell\">\n          <time class=\"publication_date\" datetime=\"2026-10-05\" id=\"news_small_list_1405313434_3\"><span class=\"sr-only\">5 października 2026</span><span aria-hidden=\"true\" class=\"day\">5</span><span aria-hidden=\"true\" class=\"month\">października</span></time>\n         </div>\n         <div class=\"title_news\">\n          <a aria-describedby=\"news_small_list_1405313434_3\" class=\"news_small_list__link link_style_1\" href=\"/aktualnosci?news_id=1107468-podsumowanie-wdrozenia-systemu-transakcyjnego-wats\">Podsumowanie wdrożenia systemu transakcyjnego WATS</a>\n         </div>\n        </li>\n       </ul>\n       <a aria-label=\"Zobacz wszystkie aktualności\" class=\"news_small_list__viewLink \" href=\"/aktualnosci\">Zobacz wszystkie</a>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"layout_element layout_section\">\n <div class=\"layout_element layout_container\" style=\"background-color: #EDEDF5\">\n  <div class=\"layout_element layout_row row\">\n   <div class=\"layout_element layout_column col-xs-12 col-sm-12 col-md-6 col-lg-6\" style=\"padding:0px 15px 0px 15px\">\n    <div id=\"component_wrapper_1405313445\" class=\"layout_element component_wrapper wrapped_news_small_list\">\n     <div class=\"component news_small_list notPrintable space--bottomZero header-upp component_1405313445\" data-component-id=\"1405313445\" data-component-type-code=\"news_small_list\" data-js-parameters=\"{}\" id=\"news_small_list_1_04122023\">\n      <div class=\"news_small_list-inner\">\n       <h2 class=\"news_small_list__header isMobileLink\">Przerwy serwisowe i niedostępności</h2>\n       <ul class=\"news_small_list_content content_area\">\n        <li class=\"table_news\">\n         <div class=\"publication_cell\">\n          <time class=\"publication_date\" datetime=\"2026-10-15\" id=\"news_small_list_1405313445_1\"><span class=\"sr-only\">15 października 2026</span><span aria-hidden=\"true\" class=\"day\">15</span><span aria-hidden=\"true\" class=\"month\">października</span></time>\n         </div>\n         <div class=\"title_news\">\n          <a aria-describedby=\"news_small_list_1405313445_1\" class=\"news_small_list__link link_style_1\" href=\"/aktualnosci/przerwy-serwisowe-niedostepnosci?news_id=1107478-niedostepnosc-maklera-17-pazdziernika-2026\">Niedostępność Maklera 17 października 2026</a>\n         </div>\n        </li>\n       </ul>\n       <a class=\"news_small_list__viewLink \" href=\"/aktualnosci/przerwy-serwisowe-niedostepnosci\">Wszystkie przerwy serwisowe</a>\n      </div>\n     </div>\n    </div>\n    <div id=\"component_wrapper_1405313436\" class=\"layout_element component_wrapper wrapped_content\">\n     <div class=\"component content component_1405313436 space--topZero\" data-component-id=\"1405313436\" data-component-type-code=\"content\" data-js-parameters=\"{}\" id=\"content_1_04122023\">\n      <div class=\"content_area\" id=\"1405313436\">\n       <p><a data-show=\"dialog\" aria-label=\"\" href=\"#utrudnienia\">Dlaczego prowadzimy prace serwisowe?</a></p>\n      </div>\n     </div>\n    </div>\n   </div>\n   <div class=\"layout_element layout_column col-xs-12 col-sm-12 col-md-6 col-lg-6\">\n    <div id=\"component_wrapper_1405313449\" class=\"layout_element component_wrapper wrapped_content\">\n     <div class=\"component content header-upp component_1405313449\" data-component-id=\"1405313449\" data-component-type-code=\"content\" data-js-parameters=\"{}\" id=\"content_2_04122023\">\n      <div class=\"content_area\" id=\"1405313449\">\n       <h2>Mamy coś dla Ciebie</h2>\n      </div>\n     </div>\n    </div>\n    <div id=\"component_wrapper_1405313447\" class=\"layout_element component_wrapper wrapped_generic_block\">\n     <div class=\"component generic_block notPrintable fix-icon-size component_1405313447 space--topZero space--bottomSmall\" data-component-id=\"1405313447\" data-component-type-code=\"generic_block\" data-js-parameters=\"{}\" id=\"generic_block_1_18122025\">\n      <div class=\"generic_block__wrapper generic_block__with_link\">\n       <div class=\"generic_block__image\">\n        <img alt=\"\" class=\"generic_block__large-icon\" src=\"/_fileserver/item/swts18n.532531fea64091a6f7e775e3d881ee9f0af5606511df074272c3241af53300ce\">\n       </div>\n       <div class=\"generic_block__text content_area\">\n        <h3 class=\"generic_block__header\">Jak zadbać o zdrowie finansowe</h3>\n        <div>\n         <div class=\"generic_block__link_new_line\">\n          <p>Zdrowie finansowe to stan, w&nbsp;którym czujesz finansowy spokój i&nbsp;masz poczucie bezpieczeństwa. Podpowiadamy, jak o&nbsp;nie zadbać.</p>\n         </div>\n         <a aria-label=\"Sprawdź artykuły o finansach\" class=\"\" href=\"/wiem/zdrowie-finansowe\">Sprawdź</a>\n        </div>\n       </div>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"layout_element layout_section\">\n <div class=\"layout_element layout_row row\">\n  <div class=\"layout_element layout_column col-xs-12 col-sm-12 col-md-12 col-lg-12\">\n   <div id=\"component_wrapper_1405313453\" class=\"layout_element component_wrapper wrapped_content\">\n    <div aria-labelledby=\"labelledby_component_1405313453_20\" class=\"component content component_1405313453 dialog-wrapper dialog--medium\" data-component-id=\"1405313453\" data-component-type-code=\"content\" data-js-parameters=\"{}\" id=\"utrudnienia\" role=\"dialog\">\n     <h2 class=\"medium dialog-header\" id=\"labelledby_component_1405313453_20\">&nbsp;Dlaczego prowadzimy prace serwisowe</h2>\n     <button class=\"dialog-close\" aria-label=\"Zamknij\"><span aria-hidden class=\"web-icon icon-close\"></span></button>\n     <div class=\"dialog-content\">\n      <div class=\"content_area\" id=\"1405313453\">\n       <p><strong>Jako bank, który stoi na straży Twoich pieniędzy, a zarazem jako firma technologiczna, dopasowujemy się do zmian rynkowych i uwarunkowań technologicznych. Niesie to za sobą poważne wyzwania, którym musimy sprostać, bo naszym priorytetem jest bezpieczeństwo.</strong></p>\n       <p>Okresowo aktualizujemy oprogramowanie i sprzęt. Powoduje to chwilowe niedostępności niektórych usług i systemów. Dlatego robimy to wtedy, gdy aktywność naszych klientów jest najniższa. Najczęściej w nocy, ale też nie zawsze jest to możliwe.&nbsp;</p>\n       <p>Jeśli zauważysz, że coś nie działa tak jak powinno - nie panikuj. Jeśli akurat jest noc, bardzo możliwe, że trwa jedna z przerw serwisowych i za kilka godzin wszystko wróci do normy. Sprawdź informacje na stronie banku. Zawsze informujemy o przerwach w dostępie do naszych usług. Twoje pieniądze są bezpieczne, po prostu musisz chwilę poczekać na dostęp do nich.</p>\n       <p>Przepraszamy Cię za te utrudnienia i prosimy o zrozumienie. Robimy to, by Twoje pieniądze były bezpieczne i bankowało Ci się z nami wygodniej.</p>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"layout_element layout_section\">\n <div class=\"layout_element layout_container\">\n  <div class=\"layout_element no_border layout_row row\">\n   <div class=\"layout_element layout_column col-xs-12 col-sm-12 col-md-12 col-lg-12\">\n    <div id=\"component_wrapper_1405313435\" class=\"layout_element component_wrapper wrapped_user_component hidden-xs hidden-md hidden-sm hidden-lg\">\n     <div class=\"component user_component component_1405313435\" data-component-id=\"1405313435\" data-component-type-code=\"user_component\" data-js-parameters=\"{}\" id=\"user_component_1_13012023\">\n      <cms-user-component class=\"\" src=\"/_api/core/user-component/RRSO_CSS\">\n       <div class=\"content_area\">\n        <style>\n  [src*=\"kantor-\"] div.content_area,\n  [src*=\"RRSO-\"] div.content_area,\n  [src*=\"disc-kk-data-\"] div.content_area,\n  [src*=\"bonus-oproc-\"] div.content_area,\n  [src*=\"bonus-kwota-\"] div.content_area,\n  [src*=\"bonus-saldo-\"] div.content_area,\n  [src*=\"bonus-data-\"] div.content_area,\n  [src*=\"Lzd-oproc-\"] div.content_area,\n  [src*=\"sub-oproc-oko\"] div.content_area,\n  [src*=\"kwota-sub-oproc-oko\"] div.content_area,\n  [src*=\"Oprocentowanie-\"] div.content_area {\n      display: inline-block !important;\n  }\n  strong [src*=\"Oprocentowanie-\"] div.content_area,\n  strong [src*=\"RRSO-\"] div.content_area {\n    font-weight: bold !important;\n  }\n</style>\n       </div>\n      </cms-user-component>\n     </div>\n    </div>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"layout_element layout_section\">\n <div class=\"layout_element layout_container\">\n  <div class=\"layout_element layout_row row\">\n   <div class=\"layout_element layout_column col-xs-12 col-sm-12 col-md-12 col-lg-12\">\n    <div id=\"component_wrapper_1405313438\" class=\"layout_element component_wrapper wrapped_content\">\n     <div class=\"component content component_1405313438\" data-component-id=\"1405313438\" data-component-type-code=\"content\" data-js-parameters=\"{}\" id=\"content_1_17102024\">\n      <div class=\"content_area\" id=\"1405313438\">\n       <h2 class=\"header-upp\" id=\"objasnienia\">Objaśnienia</h2>\n       <p><sup>1&nbsp;</sup>Oprocentowanie do 5,5% (zmienne obliczane w skali roku) obowiązuje przez 3 miesiące od otwarcia konta.</p>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n </div>\n</div>\n                    </main>\n                    <footer id=\"outlet-footer\" class=\"outlet outlet-footer\" data-resource-id=\"1500168.63705df13c82ee19e7eac70b3d13044fd9af7d00acf8fb5933dc38d14c849f29\">\n                        <div class=\"layout_section footer_section layout_element\">\n <div class=\"layout_container layout_element\">\n  <div class=\"layout_row row layout_element\">\n   <div class=\"layout_column col-xs-12 col-sm-12 col-md-12 col-lg-12 layout_element\">\n    <div class=\"component footer notPrintable component_32872911\" data-component-id=\"32872911\" data-component-type-code=\"footer\">\n     <div class=\"footer__inner\">\n      <button class=\"footer__scrollTop js-footer__scrollTop\"><span class=\"icon-arrow\" aria-hidden=\"true\"></span> Wróć na górę</button>\n      <div class=\"footer__body\">\n       <div class=\"footer__bodyContainer\">\n        <nav class=\"footer__menu js-footer__menu\">\n         <div class=\"footer__menuElement footer__menuElement--order4\">\n          <h2 class=\"footer__menuHeader js-footer__menuHeader\" id=\"oBankuFooterMenu\">O banku <span class=\"web-icon icon-arrow\" aria-hidden=\"true\"></span></h2>\n          <div class=\"footer__menuItems js-footer__menuItems\" role=\"region\" aria-labelledby=\"oBankuFooterMenu\" id=\"footerColumn1\">\n           <cms-menu src=\"/_api/core/menu/pwa_footer_first_column.c997c63b8f3bcb4765e9bb917431343f23e6522a4726f433932d2d2cbe43f9e4\">\n            <ul class=\"