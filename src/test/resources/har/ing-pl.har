s//web-fonts.woff\") format(\"woff\");\n}\n@media (min-width: 601px) {\n  .generic_block {\n    padding-top: 32px;\n    padding-bottom: 32px;\n  }\n}\n@media (max-width: 600px) {\n  .generic_block {\n    padding-top: 16px;\n    padding-bottom: 16px;\n  }\n}\n.generic_block {\n  contain: layout inline-size;\n  container-type: inline-size;\n}\n.generic_block__wrapper {\n  display: flex;\n  padding: 32px;\n  padding-left: 48px;\n  border-radius: 14px;\n  background-color: var(--color-ingWhite);\n  box-shadow: 0px 18px 40px 0px rgba(0, 0, 0, 0.08), 0px 5px 15px 0px rgba(0, 0, 0, 0.04);\n}\n.generic_block__wrapper:not(:has(a)):active {\n  background-color: var(--color-ingWhite);\n}\n.generic_block__wrapper:not(:has(a)):hover {\n  box-shadow: 0px 18px 40px 0px rgba(0, 0, 0, 0.08), 0px 5px 15px 0px rgba(0, 0, 0, 0.04);\n}\n.generic_block__wrapper:not(:has(a)):focus {\n  outline: none;\n  border-radius: 14px;\n}\n.generic_block__wrapper:has(a.hidden):focus {\n  outline: 2px solid #335D7D;\n  border-radius: 14px;\n}\n.generic_block__wrapper:has(a.hidden):active {\n  background-color: #f0f0f0;\n}\n.generic_block__wrapper:has(a.hidden):hover {\n  box-shadow: 0px 24px 60px 0px rgba(0, 0, 0, 0.12), 0px 8px 20px 0px rgba(0, 0, 0, 0.06);\n}\n@media (max-width: 600px) {\n  .generic_block__wrapper:focus {\n    outline: none;\n    border-radius: 14px;\n  }\n  .generic_block__wrapper:active {\n    background-color: #f0f0f0;\n  }\n  .generic_block__wrapper:hover {\n    box-shadow: 0px 24px 60px 0px rgba(0, 0, 0, 0.12), 0px 8px 20px 0px rgba(0, 0, 0, 0.06);\n  }\n}\n.generic_block__image {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 32px;\n  min-width: 128px;\n}\n.generic_block__text {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  width: 100%;\n}\n.generic_block__header {\n  display: block;\n  font-weight: bold;\n  line-height: 24px;\n  margin: 0 0 8px;\n  font-size: 16px;\n}\n.generic_block__link_new_line p {\n  m