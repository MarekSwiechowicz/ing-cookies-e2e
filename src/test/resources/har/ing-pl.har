\\n<div>\\n<p>To bank dzwoni do Ciebie?&nbsp;<strong>Upewnij się, że to nie oszustwo.</strong> <a aria-label=\\\"Więcej o oszustwie na infolinię\\\" class=\\\"dialog-close-button\\\" href=\\\"/indywidualni/bankowosc-internetowa-mojeing/bezpieczenstwo/weryfikacja-telefonu-z-ing\\\">Więcej</a></p>\\n</div>\\n</div>\\n\\n<hr />\\n  \\n<h3><span lang=\\\"en\\\">English</span></h3>\\n\\t<p><span lang=\\\"en\\\">Monday-Friday 8:00-18:00</span></p>\\n<h3><span lang=\\\"ru\\\">Русскоязычная рабочие дни</span></h3> \\n\\t<p><span lang=\\\"ru\\\">8:00-18:00</span></p>\\n\\n  </div>\\n  </div></div>\",\"js\":{\"runtimeScripts\":[],\"libraries\":[]},\"css\":[],\"isPublished\":true}"},"headersSize":428,"bodySize":948,"redirectURL":"","_transferSize":1376},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":25.427,"receive":0.356},"serverIPAddress":"45.60.14.95","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.ingbank.pl","issuer":"HydrantID Server CA O1","validFrom":1789638935,"validTo":1806832475}},{"pageref":"page@b60ace54ab992961b4b131eaeb0ffe40","startedDateTime":"2026-10-15T16:33:01.536Z","time":123.159,"request":{"method":"GET","url":"https://www.ing.pl/_static/user-component/node_visibility_based_on_segment/node_visibility_based_on_segment.082c87da89b6670a27ae.js","httpVersion":"HTTP/1.1","cookies":[{"name":"route_a7db4ebfee70a8fbc00e2b05d311e75f","value":"433dd576bdfc7612d298d0f5c59a2e1d"},{"name":"visid_incap_99947","value":"IgrZeEt2R92l3mnkcSbzbDwA0WoAAAAAQUIPAAAAAACUWasYqXKqKYA71FibHjAx"},{"name":"incap_ses_683_99947","value":"huuUQADSFX34LBgR8oB6CTwA0WoAAAAAqHT4X+IDk4C31lABzEHuHQ=="}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"pl-PL"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"route_a7db4ebfee70a8fbc00e2b05d311e75f=433dd576bdfc7612d298d0f5c59a2e1d; visid_incap_99947=IgrZeEt2R92l3mnkcSbzbDwA0WoAAAAAQUIP