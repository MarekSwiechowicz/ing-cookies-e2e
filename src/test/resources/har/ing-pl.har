/* (min-width: 961px)\n * Odpowiednik dla @include media-breakpoint-up(lg)\n */\n/* (min-width: 361px) and (max-width: 1280px)\n * Odpowiednik dla @include media-breakpoint-between(sm,lg)\n */\n/* (max-width: 1280px)\n * Odpowiednik @include media-breakpoint-down(lg)\n */\n/* (min-width: 961px)\n * Odpwiednik @include media-breakpoint-up(lg)\n */\n/* (min-width: 361px) and (max-width: 1280px)\n * Niestandardowy breakpoint. Brak obsługi po stronie bootstrapa\n */\n/**\n  1. Colors\n  2. Border\n  3. Font\n  4. Elementy interface\n  5. Space\n  6. z-index\n  7. Button\n  8. Shadows\n  9. Icon\n  10. Transitions\n  11. Component variables\n\n**/\n/**\n  * 1. Colors\n*/\n/**\n  * 3. Font\n*/\n/**\n  * 4. Elementy interface\n*/\n/* Line height's PING */\n/* Header PWA */\n/**\n  * 5. Space\n*/\n/* Spacers PING */\n/**\n  * 6. z-index\n*/\n/**\n  * 6. Button\n*/\n/**\n  * 8. Shadows\n*/\n/* Box shadows */\n/**\n  * 9. Icon\n*/\n/* Icon sizes */\n/**\n  * 10. Transitions\n*/\n/**\n  * 11. Component variables\n*/\n/* Ripple */\n/* Cookies policy core styles */\n#cpm-wrapper *,\n#cpm-wrapper *::before,\n#cpm-wrapper *::after {\n  box-sizing: border-box;\n}\n#cpm-wrapper {\n  font-family: INGme, \"ING me\", Helvetica, Arial, sans-serif;\n}\n#cpm-wrapper .cookie-policy__srOnly {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n#cpm-wrapper .cookie-policy-toggle-button:focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-toggle-button:focus-visible {\n  outline: 2px solid #335D7D;\n  outline-offset: 2px;\n  box-shadow: inset 0 0 0 3px white;\n  border-radius: 15px;\n}\n#cpm-wrapper .cookie-policy-toggle-button {\n  width: 42px;\n  height: 24px;\n  border-radius: 15px;\n  display: inline-block;\n  position: relative;\n  cursor: pointer;\n  -webkit-user-select: none;\n     -moz-user-select: none;\n      -ms-user-select: none;\n          user-select: none;\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-toggle-button.state-disabled {\n  pointer-events: none;\n}\n#cpm-wrapper .cookie-policy-toggle-button.state-disabled .cookie-policy-slider-thumb {\n  background-color: #d9d9d9;\n}\n#cpm-wrapper .cookie-policy-toggle-slider {\n  outline: 1px solid transparent;\n  display: block;\n  height: 24px;\n  width: 42px;\n  background-color: #696969;\n  border-radius: 15px;\n  transition: background-color 0.3s;\n}\n#cpm-wrapper .cookie-policy-slider-thumb {\n  outline: 1px solid transparent;\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 20px;\n  height: 20px;\n  background-color: white;\n  border-radius: 50%;\n  transition: transform 0.3s;\n}\n#cpm-wrapper {\n  /* When the toggle is active (checked state) */\n}\n#cpm-wrapper .cookie-policy-toggle-button[aria-checked=true] .cookie-policy-toggle-slider {\n  background-color: #349651;\n}\n#cpm-wrapper .cookie-policy-toggle-button[aria-checked=true] .cookie-policy-slider-thumb {\n  transform: translateX(18px);\n}\n#cpm-wrapper .cookie-policy-type-wrapper {\n  padding-left: 4px;\n}\n#cpm-wrapper .cpm__transitionHelper {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n  transition: all 0.3s;\n}\n#cpm-wrapper .cpm__transitionHelper {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n  transition: all 0.3s;\n}\n#cpm-wrapper .cpm__transitionHelper.isActive {\n  font-size: 0;\n}\n#cpm-wrapper.cpm-stylesLoaded {\n  visibility: visible;\n  opacity: 1;\n  pointer-events: auto;\n}\n#cpm-wrapper .cpm--hidden {\n  display: none;\n}\n#cpm-wrapper .cpm--block {\n  display: block;\n}\n#cpm-wrapper .visible-xs {\n  display: none !important;\n}\n#cpm-wrapper .is--disabled {\n  cursor: default;\n  pointer-events: none;\n  position: relative;\n  opacity: 0.5;\n}\n#cpm-wrapper a:hover {\n  text-decoration: underline;\n}\n#cpm-wrapper .cookie-radio {\n  display: none;\n}\n#cpm-wrapper a {\n  color: var(--color-fg-secondary);\n  display: inline-block;\n  transition: all 0.125s cubic-bezier(0.4, 0, 0.2, 1);\n}\n@media (prefers-reduced-motion: reduce) {\n  #cpm-wrapper a {\n    transition: none;\n  }\n}\n#cpm-wrapper a:focus {\n  outline: none;\n}\n#cpm-wrapper a:focus-visible {\n  outline: 2px solid var(--color-border-focus-outside);\n  outline-offset: 2px;\n  box-shadow: 0 0 0 3px var(--color-border-focus-inside);\n  border-radius: 1px;\n}\n#cpm-wrapper a {\n  text-decoration: underline;\n  text-underline-offset: 5px;\n  text-decoration-thickness: 1px;\n}\n#cpm-wrapper a:hover {\n  background: var(--color-bg-hover);\n  text-decoration: underline;\n  text-underline-offset: 5px;\n  text-decoration-thickness: 1px;\n}\n#cpm-wrapper a:focus-visible {\n  text-decoration: underline;\n  text-underline-offset: 5px;\n  text-decoration-thickness: 1px;\n}\n#cpm-wrapper a:active {\n  text-decoration: none;\n  background-color: transparent;\n}\n#cpm-wrapper a:visited {\n  color: var(--color-fg-tertiary);\n}\n#cpm-wrapper p {\n  margin-bottom: 8px;\n}\n#cpm-wrapper p + p {\n  margin-top: 0;\n}\n#cpm-wrapper input:checked + label::after {\n  opacity: 1;\n  transform: scale(1);\n}\n#cpm-wrapper .cookie-policy-popup {\n  position: fixed;\n  z-index: 9999;\n  left: 0;\n  right: 0;\n  top: auto;\n  bottom: 32px;\n}\n@media (max-width: 960px) {\n  #cpm-wrapper .cookie-policy-popup {\n    bottom: 0;\n  }\n}\n#cpm-wrapper .cookie-policy-popup {\n  background-color: rgba(0, 0, 0, 0);\n  pointer-events: none;\n  margin: 0 auto;\n  max-width: 1232px;\n}\n@media screen and (min-width: 1200px) and (max-width: 1280px) {\n  #cpm-wrapper .cookie-policy-popup {\n    max-width: 1152px;\n  }\n}\n@media screen and (min-width: 601px) and (max-width: 1199px) {\n  #cpm-wrapper .cookie-policy-popup {\n    max-width: calc(100vw - 48px);\n  }\n}\n@media (min-width: 601px) {\n  #cpm-wrapper .