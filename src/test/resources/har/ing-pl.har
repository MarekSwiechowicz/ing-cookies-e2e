sion":29319,"text":"@charset \"UTF-8\";\n/* (max-width: 360px)\n * Odpowiednik dla @include media-breakpoint-down(xs)\n */\n/* (min-width: 361px)\n * Odpowiednik dla @include media-breakpoint-up(sm)\n */\n/* (min-width: 361px) and (max-width: 600px)\n * Odpowiednik dla @include media-breakpoint-between(sm,sm);\n */\n/* (max-width: 600px)\n * Odpowiednik dla @include media-breakpoint-down(sm)\n */\n/* (min-width: 601px)\n * Odpowiednik dla @include media-breakpoint-up(md)\n */\n/* (max-width: 960px)\n * Odpowiednik dla @include media-breakpoint-down(md)\n */\n/* (min-width: 601px) and (max-width: 960px)\n * Odpowiednik dla @include media-breakpoint-only(md)\n */\n/* (min-width: 961px)\n * Odpowiednik dla @include media-breakpoint-up(lg)\n */\n/* (min-width: 361px) and (max-width: 1280px)\n * Odpowiednik dla @include media-breakpoint-between(sm,lg)\n */\n/* (max-width: 1280px)\n * Odpowiednik @include media-breakpoint-down(lg)\n */\n/* (min-width: 961px)\n * Odpwiednik @include media-breakpoint-up(lg)\n */\n/* (min-width: 361px) and (max-width: 1280px)\n * Niestandardowy breakpoint. Brak obsługi po stronie bootstrapa\n */\n/**\n  1. Colors\n  2. Border\n  3. Font\n  4. Elementy interface\n  5. Space\n  6. z-index\n  7. Button\n  8. Shadows\n  9. Icon\n  10. Transitions\n  11. Component variables\n\n**/\n/**\n  * 1. Colors\n*/\n/**\n  * 3. Font\n*/\n/**\n  * 4. Elementy interface\n*/\n/* Line height's PING */\n/* Header PWA */\n/**\n  * 5. Space\n*/\n/* Spacers PING */\n/**\n  * 6. z-index\n*/\n/**\n  * 6. Button\n*/\n/**\n  * 8. Shadows\n*/\n/* Box shadows */\n/**\n  * 9. Icon\n*/\n/* Icon sizes */\n/**\n  * 10. Transitions\n*/\n/**\n  * 11. Component variables\n*/\n/* Ripple */\n/* Cookies policy core styles */\n#cpm-wrapper *,\n#cpm-wrapper *::before,\n#cpm-wrapper *::after {\n  box-sizing: border-box;\n}\n#cpm-wrapper {\n  font-family: INGme, \"ING me\", Helvetica, Arial, sans-serif;\n}\n#cpm-wrapper .cookie-policy__srOnly {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n#cpm-wrapper .cookie-policy-toggle-button:focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-toggle-button:focus-visible {\n  outline: 2px solid #335D7D;\n  outline-offset: 2px;\n  box-shadow: inset 0 0 0 3px white;\n  border-radius: 15px;\n}\n#cpm-wrapper .cookie-policy-toggle-button {\n  width: 42px;\n  height: 24px;\n  border-radius: 15px;\n  display: inline-block;\n  position: relative;\n  cursor: pointer;\n  -webkit-user-select: none;\n     -moz-user-select: none;\n      -ms-user-select: none;\n          user-select: none;\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-toggle-button.state-disabled {\n  pointer-events: none;\n}\n#cpm-wrapper .cookie-policy-toggle-button.state-disabled .cookie-policy-slider-thumb {\n  background-color: #d9d9d9;\n}\n#cpm-wrapper .cookie-policy-toggle-slider {\n  outline: 1px solid transparent;\n  display: block;\n  height: 24px;\n  width: 42px;\n  background-color: #696969;\n  border-radius: 15px;\n  transition: background-color 0.3s;\n}\n#cpm-wrapper .cookie-policy-slider-thumb {\n  outline: 1px solid transparent;\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 20px;\n  height: 20px;\n  background-color: white;\n  border-radius: 50%;\n  transition: transform 0.3s;\n}\n#cpm-wrapper {\n  /* When the toggle is active (checked state) */\n}\n#cpm-wrapper .cookie-policy-toggle-button[aria-checked=true] .cookie-policy-toggle-slider {\n  background-color: #349651;\n}\n#cpm-wrapper .cookie-policy-toggle-button[aria-checked=true] .cookie-policy-slider-thumb {\n  transform: translateX(18px);\n}\n#cpm-wrapper .cookie-policy-type-wrapper {\n  padding-left: 4px;\n}\n#cpm-wrapper .cpm__transitionHelper {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n  transition: all 0.3s;\n}\n#cpm-wrapper .cpm__transitionHelper {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n  transition: all 0.3s;\n}\n#cpm-wrapper .cpm__transitionHelper.isActive {\n  font-size: 0;\n}\n#cpm-wrapper.cpm-stylesLoaded {\n  visibility: visible;\n  opacity: 1;\n  pointer-events: auto;\n}\n#cpm-wrapper .cpm--hidden {\n  display: none;\n}\n#cpm-wrapper .cpm--block {\n  display: block;\n}\n#cpm-wrapper .visible-xs {\n  display: none !important;\n}\n#cpm-wrapper .is--disabled {\n  cursor: default;\n  pointer-events: none;\n  position: relative;\n  opacity: 0.5;\n}\n#cpm-wrapper a:hover {\n  text-decoration: underline;\n}\n#cpm-wrapper .cookie-radio {\n  display: none;\n}\n#cpm-wrapper a {\n  color: var(--color-fg-secondary);\n  display: inline-block;\n  transition: all 0.125s cubic-bezier(0.4, 0, 0.2, 1);\n}\n@media (prefers-reduced-motion: reduce) {\n  #cpm-wrapper a {\n    transition: none;\n  }\n}\n#cpm-wrapper a:focus {\n  outline: none;\n}\n#cpm-wrapper a:focus-visible {\n  outline: 2px solid var(--color-border-focus-outside);\n  outline-offset: 2px;\n  box-shadow: 0 0 0 3px var(--color-border-focus-inside);\n  border-radius: 1px;\n}\n#cpm-wrapper a {\n  text-decoration: underline;\n  text-underline-offset: 5px;\n  text-decoration-thickness: 1px;\n}\n#cpm-wrapper a:hover {\n  background: var(--color-bg-hover);\n  text-decoration: underline;\n  text-underline-offset: 5px;\n  text-decoration-thickness: 1px;\n}\n#cpm-wrapper a:focus-visible {\n  text-decoration: underline;\n  text-underline-offset: 5px;\n  text-decoration-thickness: 1px;\n}\n#cpm-wrapper a:active {\n  text-decoration: none;\n  background-color: transparent;\n}\n#cpm-wrapper a:visited {\n  color: var(--color-fg-tertiary);\n}\n#cpm-wrapper p {\n  margin-bottom: 8px;\n}\n#cpm-wrapper p + p {\n  margin-top: 0;\n}\n#cpm-wrapper input:checked + label::after {\n  opacity: 1;\n  transform: scale(1);\n}\n#cpm-wrapper .cookie-policy-popup {\n  position: fixed;\n  z-index: 9999;\n  left: 0;\n  right: 0;\n  top: auto;\n  bottom: 32px;\n}\n@media (max-width: 960px) {\n  #cpm-wrapper .cookie-policy-popup {\n    bottom: 0;\n  }\n}\n#cpm-wrapper .cookie-policy-popup {\n  background-color: rgba(0, 0, 0, 0);\n  pointer-events: none;\n  margin: 0 auto;\n  max-width: 1232px;\n}\n@media screen and (min-width: 1200px) and (max-width: 1280px) {\n  #cpm-wrapper .cookie-policy-popup {\n    max-width: 1152px;\n  }\n}\n@media screen and (min-width: 601px) and (max-width: 1199px) {\n  #cpm-wrapper .cookie-policy-popup {\n    max-width: calc(100vw - 48px);\n  }\n}\n@media (min-width: 601px) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-content {\n    max-height: 90vh;\n    overflow: auto;\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-content {\n  position: absolute;\n  top: auto;\n  left: 0;\n  bottom: 0;\n  max-width: 600px;\n  width: 100%;\n  height: auto;\n  padding: 16px;\n  border-radius: 4px;\n  background-color: #fff;\n  box-shadow: 0px 11px 15px -7px rgba(0, 0, 0, 0.2), 0px 24px 38px 3px rgba(0, 0, 0, 0.14), 0px 9px 46px 8px rgba(0, 0, 0, 0.12);\n  z-index: inherit;\n  pointer-events: auto;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-content:focus-visible {\n  outline: 2px solid #335D7D;\n  border-radius: 14px;\n  outline-offset: -2px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-description {\n  -ms-scroll-chaining: none;\n      overscroll-behavior: contain;\n  max-height: 230px;\n  overflow-y: auto;\n  margin-top: 32px;\n  scrollbar-color: #a8a8a8;\n  scrollbar-width: thin;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-description::-webkit-scrollbar {\n  width: 3px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-description::-webkit-scrollbar-track {\n  border-radius: 8px;\n  background-color: #fff;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-description::-webkit-scrollbar-thumb {\n  border-radius: 8px;\n  background-color: #a8a8a8;\n}\n@media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-description {\n    scrollbar-base-color: #535353;\n    scrollbar-3dlight-color: #a8a8a8;\n    scrollbar-highlight-color: #a8a8a8;\n    scrollbar-track-color: #a8a8a8;\n    scrollbar-arrow-color: #535353;\n    scrollbar-shadow-color: #a8a8a8;\n    scrollbar-dark-shadow-color: #a8a8a8;\n  }\n}\n@media (max-height: 630px) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-description {\n    max-height: none;\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-title {\n  font-size: 19px;\n  font-weight: bold;\n  line-height: 28px;\n  text-align: center;\n  position: relative;\n  margin-bottom: 0;\n  padding: 0 26px 8px 26px;\n}\n@media (max-width: 600px) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-title {\n    font-size: 16px;\n    padding: 0 16px 8px 16px;\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-title:after {\n  top: auto;\n  bottom: -8px;\n  left: -16px;\n  right: -16px;\n  content: \"\";\n  position: absolute;\n  height: 1px;\n  background-color: #d9d9d9;\n  z-index: -10;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left {\n  background: none;\n  border: none;\n  cursor: pointer;\n  box-shadow: none;\n  color: #696969;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:focus-visible {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left {\n  z-index: 100;\n  width: 44px;\n  height: 44px;\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  background-color: var(--color-ingWhite);\n}\n@media (max-width: 600px) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left {\n    left: 4px;\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:hover, #cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:active {\n  border-radius: 8px;\n  background: #d9d9d9;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:focus-visible {\n  outline: 2px solid #335D7D;\n  outline-offset: -2px;\n  box-shadow: inset 0 0 0 3px white;\n  border-radius: 10px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:before {\n  content: \"\";\n  background-size: 44px;\n  background-position: center;\n  position: absolute;\n  width: 24px;\n  height: 24px;\n  background-repeat: no-repeat;\n  background-image: url(\"data:image/svg+xml;base64,\");\n}\n@media (prefers-contrast: more) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:before {\n    background-image: url(\"data:image/svg+xml;base64,\");\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-arrow--left:before {\n  left: 10px;\n  top: 9px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper {\n  display: flex;\n  justify-content: flex-end;\n  width: 100%;\n  gap: 10px;\n  padding: 16px 0 0;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button {\n  transition: all 0.125s cubic-bezier(0.4, 0, 0.2, 1);\n}\n@media (prefers-reduced-motion: reduce) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button {\n    transition: none;\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button {\n  border-radius: 8px;\n  font-weight: 700;\n  font-size: 19px;\n  line-height: 28px;\n  display: inline-block;\n  background: #525199;\n  color: var(--color-ingWhite);\n  padding: 8px 16px;\n  border: 1px solid transparent;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button:hover {\n  background-color: #525199;\n  color: var(--color-ingWhite);\n  box-shadow: 0 3px 5px -1px rgba(0, 0, 0, 0.2), 0 1px 18px 0 rgba(0, 0, 0, 0.12), 0 6px 10px 0 rgba(0, 0, 0, 0.14);\n  border-color: #525199;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button:focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button:focus-visible {\n  outline: 2px solid #335D7D;\n  outline-offset: -2px;\n  box-shadow: inset 0 0 0 3px white;\n  border-radius: 8px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button:active {\n  background-color: #525199;\n  color: var(--color-ingWhite);\n  opacity: 0.6;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button.disabled, #cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button[disabled]:not(.modal) {\n  background-color: transparent;\n  border-color: #a8a8a8;\n  color: #a8a8a8;\n  pointer-events: none;\n  cursor: default;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button.disabled:focus, #cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button[disabled]:not(.modal):focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button {\n  padding: 6px 10px;\n  font-size: 14px;\n  line-height: 20px;\n  color: #FFFFFF;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-wrapper .cookie-policy-button:hover {\n  color: #FFFFFF;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-group {\n  position: relative;\n  display: flex;\n  justify-content: flex-end;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-btn-group:after {\n  top: -1px;\n  bottom: -16px;\n  left: -16px;\n  right: -16px;\n  content: \"\";\n  position: absolute;\n  height: 1px;\n  background-color: #d9d9d9;\n  z-index: -10;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-form-group {\n  display: inline-block;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-form-group:first-child {\n  margin: 20px 45px 20px 0;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-form-group:last-child {\n  margin-bottom: 20px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton {\n  background-color: transparent;\n  transition: none;\n  font-size: 14px;\n  border: none;\n  line-height: 20px;\n  border-radius: 8px;\n  padding: 5px 8px 5px 27px;\n  position: relative;\n  color: var(--color-fg-secondary);\n  font-weight: 700;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton:focus {\n  outline: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton:focus-visible {\n  outline: 2px solid #335D7D;\n  outline-offset: -1px;\n  box-shadow: inset 0 0 0 3px white;\n  border-radius: 9px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton {\n  transition: all 0.125s cubic-bezier(0.4, 0, 0.2, 1);\n}\n@media (prefers-reduced-motion: reduce) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton {\n    transition: none;\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton:hover, #cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton:active {\n  outline: 1px solid var(--color-fg-secondary) !important;\n  outline-offset: 0px;\n  border-radius: 7px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton:active {\n  background: #e6e5f0;\n  box-shadow: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton .icon-arrow:before {\n  content: \"\";\n  background-size: 11px;\n  background-position: center;\n  position: absolute;\n  width: 24px;\n  height: 24px;\n  background-repeat: no-repeat;\n  background-image: url(\"data:image/svg+xml;base64,\");\n}\n@media (prefers-contrast: more) {\n  #cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton .icon-arrow:before {\n    background-image: url(\"data:image/svg+xml;base64,\");\n  }\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton .icon-arrow:before {\n  left: 3px;\n  top: 3px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton[aria-expanded=true] .icon-arrow:before {\n  transform: rotate(180deg);\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-expandButton {\n  margin-left: 5px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-link--content {\n  display: none;\n  padding-top: 8px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-link--content.state-open {\n  display: block;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type {\n  display: flex;\n  justify-content: space-between;\n  margin: 24px 0 0;\n  padding: 0 0 16px;\n  border-bottom: 1px solid #d9d9d9;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type:last-child {\n  border-bottom: none;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type--title {\n  font-size: 16px;\n  font-weight: 700;\n  margin-bottom: 3px;\n  line-height: 24px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type--title.clickable {\n  cursor: pointer;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type--description {\n  color: #696969;\n  font-size: 14px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type .cookie-policy-switch {\n  margin-right: 8px;\n  padding-top: 4px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type .cookie-policy-switch .cookie-policy-switch-label {\n  position: relative;\n  display: inline-block;\n  width: 36px;\n  height: 16px;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type .cookie-policy-switch .cookie-policy-switch-input {\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type .cookie-policy-switch .cookie-policy-switch-slider:focus {\n  outline: none;\n  box-shadow: inset 0px 0px 1px #559bd1, 0px 0px 16px #559bd1;\n}\n#cpm-wrapper .cookie-policy-popup .cookie-policy-type .cookie-policy-switch .cookie-policy-switch-slider {\n  position: absolute;\n  cursor: pointer;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 24px;\n  width: 41px;\n  background-color: #696969;\n  border: 1px solid #696969;\n  transition: 0.4s;\n  border-radius: 34px;\n  z-index: -1;\n}\n#cpm-wrapper .cookie-policy